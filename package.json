{
  "name": "gbot",
  "productName": "gBot",
  "version": "1.0.0",
  "description": "gBot: build an AI team that works while you sleep, on your own Claude subscription",
  "main": "./out/main/index.js",
  "author": "Lucas Carvalho",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test tests/*.test.cjs",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "icon": "jiti scripts/make-icon.mts",
    "dist:win": "electron-vite build && electron-builder --win",
    "marketing": "jiti scripts/marketing/make-marketing.mts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xyflow/react": "^12.12.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.65.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jiti": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dvGomez/gBot.git"
  },
  "homepage": "https://github.com/dvGomez/gBot#readme",
  "bugs": {
    "url": "https://github.com/dvGomez/gBot/issues"
  }
}
